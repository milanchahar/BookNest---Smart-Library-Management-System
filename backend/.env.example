# ─── PostgreSQL Connection ───────────────────────────────────────────────────
# Option A: full connection string (recommended for cloud/Railway/Render)
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/booknest

# Option B: individual fields (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=yourpassword
DB_NAME=booknest

# Optional: set to "true" to force SSL (auto-enabled in production)
# DB_SSL=true

# ─── App ─────────────────────────────────────────────────────────────────────
JWT_SECRET=booknest_super_secret_key_2024
PORT=5000
FRONTEND_URL=https://your-app-name.vercel.app
